# ──────────────────────────────────────────────
# Variables de entorno para el backend
# Copiá este archivo a .env y ajustá los valores
# ──────────────────────────────────────────────

# Puerto del servidor (default: 3000)
PORT=3000

# URI de conexión a MongoDB (REQUERIDA)
# Local:  mongodb://127.0.0.1:27017/url-shortener
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/url-shortener
MONGODB_URI=mongodb://127.0.0.1:27017/url-shortener

# URL base para generar los links cortos
# En producción: https://tu-dominio.com
# En desarrollo: http://localhost:3000
BASE_URL=http://localhost:3000

# Origen(es) permitidos para CORS, separados por coma
# En producción: https://tu-frontend.com
# En desarrollo: http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# URL del frontend (para links en páginas de error)
# En producción: https://tu-frontend.com
# En desarrollo: http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Modo: development | production | test
NODE_ENV=development
